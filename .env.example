# Kopiraj u .env na serveru ili upiši iste vrednosti u cPanel → Setup Python App → Environment variables.

DJANGO_DEBUG=0
DJANGO_SECRET_KEY=zameni-sa-dugim-nasumicnim-stringom

DJANGO_ALLOWED_HOSTS=haccp.rs.itbranch.rs

DJANGO_CSRF_TRUSTED_ORIGINS=https://haccp.rs.itbranch.rs

# Opciono: apsolutna putanja do sqlite fajla (mora biti upisiva)
# DJANGO_DB_PATH=/home/KORISNIK/hasap/db.sqlite3

# Ako SSL redirect pravi petlju na hostingu, stavi 0
DJANGO_SECURE_SSL_REDIRECT=1
